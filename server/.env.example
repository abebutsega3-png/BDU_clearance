# Gmail SMTP for credential and notification emails.
# Use the HR sender's Gmail/Google Workspace address and an App Password,
# not the account's regular password. Never commit the populated .env file.
EMAIL_SERVICE=gmail
EMAIL_USER=hr-officer@example.edu
EMAIL_PASS=your-16-character-google-app-password

# Optional application URL used in email links.
APP_BASE_URL=http://localhost:5173
