# API Configuration
# Set the API URL for the backend server
# Default: http://localhost:3000/api/clearance
VITE_API_URL=http://localhost:3000/api/clearance

# For production, update to your production server URL
# Set this in the frontend hosting service's build environment to the backend URL.
# The backend URL may include /api/clearance; public endpoints use the backend origin.
# VITE_API_URL=https://yourdomain.com/api/clearance
