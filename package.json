{
  "name": "BDU_clearance",
  "version": "1.0.0",
 "scripts": {
  "dev": "concurrently --kill-others-on-fail --names \"frontend,server\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:server\"",
  "dev:frontend": "node scripts/wait-for-server.cjs && npm --prefix frontendproject run dev",
  "dev:server": "nodemon --watch server server/index.js"
},
  "devDependencies": {
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "nodemon": "^3.1.14",
    "qrcode": "^1.5.4",
    "react-router-dom": "^7.18.2",
    "socket.io": "^4.8.1"
  }
}