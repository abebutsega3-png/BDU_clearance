{
  "name": "BDU_clearance",
  "version": "1.0.0",
  "scripts": {
    "dev:frontend": "npm --prefix frontendproject run dev",
    "dev:server": "nodemon --watch server --env-file=server/.env server/index.js",
    "dev": "concurrently -k --names \"frontend,server\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:server\"",
    "start": "concurrently \"npm run dev:frontend\" \"wait-on tcp:5173 && npm run dev:server\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "nodemon": "^3.1.14",
    "path": "^0.12.7",
    "qrcode": "^1.5.4",
    "react-router-dom": "^7.18.2"
  }
}